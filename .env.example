# Copy to .env. Everything is optional; the app runs on public data without any key.

# Hourly Claude judgment and news tagging. Without it only the rule-based judgment runs.
ANTHROPIC_API_KEY=
#CLAUDE_MODEL=claude-opus-5-5

# Alert delivery to Telegram (both required).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Whale Alert "Developer Alerts API" key (paid). Enables large transfers into exchanges.
WHALE_ALERT_API_KEY=

#HOST=127.0.0.1
#PORT=8787
#DB_PATH=data/crypto-news.db
#WEB_DIR=web/build
